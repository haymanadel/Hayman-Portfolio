---
import "@fontsource-variable/readex-pro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import Wordmark from "@/components/Wordmark.astro";
import { LANGS } from "@/i18n";

const { en, ar } = { en: LANGS.en.copy.notFound, ar: LANGS.ar.copy.notFound };
---

<BaseLayout lang="en" title="404 — Hayman Adel" noindex>
  <main id="main" class="container nf">
    <a href="/" class="brand"><Wordmark /></a>
    <p class="code">404</p>
    <h1>{en.title}</h1>
    <p class="muted">{en.body}</p>
    <p class="ar" lang="ar" dir="rtl">{ar.title}</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">{en.cta} <Icon name="arrow-right" class="nudge" /></a>
      <a href="/ar/" class="btn btn-ghost" lang="ar" hreflang="ar">{ar.cta}</a>
    </div>
  </main>
</BaseLayout>

<style>
  .nf { min-height: 100svh; display: grid; align-content: center; justify-items: start; gap: 16px; padding-block: 64px; }
  .brand { margin-bottom: 24px; }
  .code { font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent-text); }
  h1 { font-size: clamp(2.2rem, 7vw, 4.5rem); letter-spacing: -0.03em; }
  .muted { color: var(--muted); }
  .ar { font-family: "Readex Pro Variable", var(--font-sans); color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .actions [lang="ar"] { font-family: "Readex Pro Variable", var(--font-sans); }
</style>
