---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Icon from "@/components/Icon.astro";
import { profile } from "@/data";
---

<BaseLayout title={`Page not found — ${profile.brand}`} noindex>
  <Header />
  <main id="main" class="container nf">
    <p class="mono code">404</p>
    <h1>This page doesn’t exist.</h1>
    <p class="muted">The link may be old or mistyped. Everything lives on the home page.</p>
    <a href="/" class="btn btn-primary">Back to home <Icon name="arrow-right" class="nudge" /></a>
  </main>
  <Footer />
</BaseLayout>

<style>
  .nf { min-height: 62svh; display: grid; align-content: center; justify-items: start; gap: 18px; padding-block: 80px; }
  .code { font-size: 0.85rem; color: var(--accent-text); }
  h1 { font-size: clamp(2.2rem, 7vw, 4.5rem); letter-spacing: -0.03em; }
  .muted { color: var(--muted); max-width: 32rem; }
</style>
