---
// Hero portrait: the background-removed photo on the site's own card surface,
// with a soft accent glow behind the subject (keeps the dark gown separated in
// dark mode). Used when `profile.photo` is set; ProfileCard is the fallback.
import { profile } from "@/data";

const photo = profile.photo!;
---

<figure class="portrait">
  <div class="glow" aria-hidden="true"></div>
  <img
    src={photo.src}
    srcset={photo.srcset}
    sizes="(min-width: 960px) 440px, min(90vw, 440px)"
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    fetchpriority="high"
    decoding="async"
  />
  <figcaption>
    <span class="dot" aria-hidden="true"></span>
    <span class="name">{profile.fullName}</span>
    <span class="role">{profile.roles[0]}</span>
  </figcaption>
</figure>

<style>
  .portrait {
    position: relative; isolation: isolate; overflow: hidden; margin: 0; aspect-ratio: 4 / 5;
    border-radius: var(--radius); border: 1px solid var(--line);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--surface);
    box-shadow: var(--shadow);
  }
  /* Accent light behind the head + a neutral lift so dark clothing never merges with the card. */
  .glow {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(42% 34% at 50% 30%, color-mix(in oklab, var(--accent) 34%, transparent), transparent 72%),
      radial-gradient(70% 55% at 50% 62%, color-mix(in oklab, var(--text) 7%, transparent), transparent 75%);
  }
  img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain; object-position: 50% 100%;
    filter: drop-shadow(0 18px 28px rgb(0 0 0 / 0.22));
  }
  figcaption {
    position: absolute; inset-inline-start: 14px; bottom: 14px; max-width: calc(100% - 28px);
    display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px 10px;
    padding: 8px 14px; border-radius: 999px;
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    font-size: 0.85rem; line-height: 1.3;
  }
  .dot { width: 8px; height: 8px; border-radius: 2px; background: var(--accent); flex: none; }
  .name { font-weight: 700; }
  .role { color: var(--muted); }
  @media (max-width: 380px) { .role { display: none; } }
</style>
