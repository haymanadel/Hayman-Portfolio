---
// Project visual. Uses the real screenshot when one is configured; otherwise
// draws an abstract, clearly illustrative composition for the project type
// (decorative only — never presented as a screenshot).
import type { Project } from "@/data/types";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const kind = project.slug === "katakito-store" ? "store" : project.slug === "olympic-gym" ? "dashboard" : project.slug === "smart-home" ? "device" : "list";
---

<div class="frame">
  <div class="chrome" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="mono url">{project.previewLabel}</span>
  </div>
  {project.image ? (
    <img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" decoding="async" />
  ) : (
    <div class:list={["art", kind]} aria-hidden="true">
      {kind === "store" && (
        <>
          <div class="hero-band"><b></b><s></s></div>
          <div class="tiles">{[0, 1, 2, 3].map(() => <div class="tile"><span></span><em></em><em class="short"></em></div>)}</div>
        </>
      )}
      {kind === "dashboard" && (
        <>
          <div class="side">{[0, 1, 2, 3, 4].map((i) => <em class:list={{ on: i === 1 }}></em>)}</div>
          <div class="main">
            <div class="kpis">{[0, 1, 2].map(() => <div><em class="short"></em><b></b></div>)}</div>
            <div class="chart">{[38, 62, 45, 80, 58, 92, 70].map((h) => <span style={`--h:${h}%`}></span>)}</div>
          </div>
        </>
      )}
      {kind === "device" && (
        <div class="oled mono">
          <p><span>T</span> 24°C <span>H</span> 41%</p>
          <p><span>Motion</span> YES</p>
          <p class="scroll">Hayman</p>
        </div>
      )}
      {kind === "list" && (
        <div class="items">
          {[82, 55, 30, 12].map((pct) => (
            <div class="item"><em></em><span class="bar"><span style={`--p:${pct}%`} class:list={{ low: pct < 20 }}></span></span></div>
          ))}
        </div>
      )}
    </div>
  )}
</div>

<style>
  .frame { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--surface); box-shadow: var(--shadow); transition: transform 500ms var(--ease), box-shadow 500ms var(--ease); }
  .chrome { display: flex; align-items: center; gap: 12px; height: 38px; padding: 0 14px; border-bottom: 1px solid var(--line); background: var(--surface-2); }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-strong); }
  .url { font-size: 0.72rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }

  .art { aspect-ratio: 16 / 10; padding: 6%; display: grid; gap: 5%; --b: color-mix(in oklab, var(--text) 10%, transparent); --b2: color-mix(in oklab, var(--text) 18%, transparent); }
  em, b, s { display: block; border-radius: 4px; }
  em { height: 8px; background: var(--b2); }
  em.short { width: 55%; }

  /* store */
  .store { grid-template-rows: 0.9fr 1fr; }
  .hero-band { border-radius: 8px; background: var(--invert-bg); display: flex; flex-direction: column; justify-content: center; gap: 10px; padding: 0 7%; }
  .hero-band b { width: 46%; height: 12px; background: color-mix(in oklab, var(--invert-text) 80%, transparent); }
  .hero-band s { width: 20%; height: 18px; border-radius: 999px; background: var(--accent); }
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4%; }
  .tile { display: grid; grid-template-rows: 1fr auto auto; gap: 6px; }
  .tile span { border-radius: 6px; background: var(--b); }

  /* dashboard */
  .dashboard { grid-template-columns: 0.22fr 1fr; }
  .side { display: grid; align-content: start; gap: 10px; padding: 8% 12%; border-radius: 8px; background: var(--invert-bg); }
  .side em { background: color-mix(in oklab, var(--invert-text) 25%, transparent); }
  .side em.on { background: var(--accent); }
  .main { display: grid; grid-template-rows: auto 1fr; gap: 8%; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5%; }
  .kpis div { display: grid; gap: 8px; padding: 10% 12%; border-radius: 8px; border: 1px solid var(--line); }
  .kpis b { height: 14px; width: 70%; background: var(--text); }
  .chart { display: flex; align-items: end; gap: 5%; padding: 4% 4% 0; border-radius: 8px; border: 1px solid var(--line); }
  .chart span { flex: 1; height: var(--h); border-radius: 4px 4px 0 0; background: var(--b2); }
  .chart span:nth-child(6) { background: var(--accent); }

  /* device */
  .device { place-items: center; background: radial-gradient(circle at 50% 40%, var(--surface-2), var(--surface)); }
  .oled { width: 72%; padding: 6% 7%; border-radius: 8px; background: #050605; color: #d8f6ff; border: 6px solid #1b1d19; font-size: clamp(0.62rem, 1.6vw, 0.86rem); line-height: 1.7; box-shadow: 0 0 0 1px #2b2d27; }
  .oled span { color: #6fb7c9; }
  .oled .scroll { padding-inline-start: 30%; }

  /* list */
  .items { display: grid; align-content: center; gap: 9%; padding: 0 4%; }
  .item { display: grid; grid-template-columns: 0.8fr 1fr; align-items: center; gap: 8%; }
  .bar { height: 10px; border-radius: 999px; background: var(--b); overflow: hidden; }
  .bar span { display: block; height: 100%; width: var(--p); border-radius: inherit; background: var(--text); }
  .bar span.low { background: var(--accent-text); }
</style>
