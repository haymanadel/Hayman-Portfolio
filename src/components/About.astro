---
import { profile } from "@/data";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionHeading index="01" label="About" id="about-title" title={profile.about.lead} />
    <div class="grid">
      <div class="body" data-reveal>
        {profile.about.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="care" data-reveal style="--delay:120ms">
        <p class="mono label">What I care about</p>
        <ul role="list">
          {profile.about.principles.map((item) => (
            <li><Icon name="check" />{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: clamp(32px, 5vw, 48px); }
  @media (min-width: 960px) { .grid { grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr); gap: 32px; } .body { grid-column: 2; } .care { grid-column: 2; } }
  .body { display: grid; gap: 18px; max-width: 44rem; font-size: clamp(1.08rem, 1.5vw, 1.2rem); }
  .body p:first-child { color: var(--text); }
  .body p + p { color: var(--muted); }
  .label { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  ul { display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); border-top: 1px solid var(--line); }
  li { display: flex; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); font-weight: 550; }
  li :global(svg) { width: 18px; height: 18px; color: var(--accent-text); flex: none; }
</style>
