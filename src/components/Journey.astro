---
import { journey, journeyNote } from "@/data";
import SectionHeading from "./SectionHeading.astro";
---

<section class="section" id="journey" aria-labelledby="journey-title">
  <div class="container">
    <SectionHeading index="05" label="Selected work & journey" id="journey-title" title="Growing through real builds." intro={journeyNote} />
    <ol role="list" class="timeline">
      {journey.map((step, i) => (
        <li data-reveal style={`--delay:${i * 60}ms`} class:list={{ now: step.period === "Now" }}>
          <span class="mono period">{step.period}</span>
          <div class="body">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            {step.project && <p class="mono project">{step.project}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline { position: relative; display: grid; }
  li { position: relative; display: grid; gap: 8px 32px; padding: 24px 0 24px 28px; border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  li::before { content: ""; position: absolute; inset-inline-start: 0; top: 32px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--text); background: var(--bg); }
  li.now::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 30%, transparent); }
  :global([dir="rtl"]) li { padding: 24px 28px 24px 0; }
  @media (min-width: 960px) {
    li { grid-template-columns: minmax(0, 0.38fr) minmax(0, 1fr); }
  }
  .period { font-size: 0.8rem; color: var(--muted); padding-top: 4px; }
  .now .period { color: var(--accent-text); }
  h3 { font-size: clamp(1.25rem, 2.4vw, 1.6rem); }
  .body p:not(.project) { margin-top: 8px; color: var(--muted); max-width: 42rem; }
  .project { margin-top: 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; }
</style>
