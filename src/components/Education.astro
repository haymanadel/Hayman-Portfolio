---
import { education } from "@/data";
import SectionHeading from "./SectionHeading.astro";

// Only facts confirmed from the certificate are shown; empty fields stay hidden.
const facts = [
  { label: "Degree", value: education.degree },
  { label: "Specialization", value: education.specialization },
  { label: "Period", value: education.period },
].filter((f): f is { label: string; value: string } => Boolean(f.value));
---

<section class="section" id="education" aria-labelledby="education-title">
  <div class="container">
    <SectionHeading index="06" label="Education" id="education-title" title="Academic foundation." />
    <div class="grid" data-reveal>
      <div class="card">
        <p class="mono short">{education.shortName}</p>
        <h3>{education.institution}</h3>
        {facts.length > 0 && (
          <dl class="facts">
            {facts.map((f) => (
              <div><dt class="mono">{f.label}</dt><dd>{f.value}</dd></div>
            ))}
          </dl>
        )}
        <p class="summary">{education.summary}</p>
      </div>
      {education.certificate && (
        <figure class="certificate">
          <img
            src={education.certificate.src}
            alt={education.certificate.alt}
            width={education.certificate.width}
            height={education.certificate.height}
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 24px; }
  @media (min-width: 960px) { .grid { grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr); gap: 32px; } .card { grid-column: 2; } .certificate { grid-column: 2; } }
  .card { padding: clamp(22px, 4vw, 40px); border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); }
  .short { display: inline-block; padding: 4px 10px; border-radius: 6px; background: var(--accent); color: var(--on-accent); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; }
  h3 { margin-top: 16px; font-size: clamp(1.4rem, 3vw, 2rem); max-width: 24ch; }
  .facts { display: grid; gap: 10px; margin-top: 20px; }
  .facts div { display: grid; grid-template-columns: 14ch 1fr; gap: 12px; }
  dt { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; padding-top: 3px; }
  dd { margin: 0; font-weight: 600; }
  .summary { margin-top: 20px; color: var(--muted); max-width: 42rem; }
  .certificate { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
</style>
