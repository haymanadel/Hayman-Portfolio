---
import { projects } from "@/data";
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";

const featured = projects.filter((p) => p.featured);
const detailed = featured.filter((p) => !p.note);
const upcoming = featured.filter((p) => p.note);
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHeading
      index="04"
      label="Selected work"
      id="work-title"
      title="Real projects, running in the real world."
      intro="Business systems and products I have designed and built — from bilingual e-commerce to management platforms and IoT prototypes."
    />
    <div class="list">
      {detailed.map((project, i) => <ProjectCard project={project} flip={i % 2 === 1} />)}
    </div>
    {upcoming.length > 0 && (
      <div class="upcoming">
        {upcoming.map((project) => <ProjectCard project={project} compact />)}
      </div>
    )}
  </div>
</section>

<style>
  .list { display: grid; gap: clamp(56px, 9vw, 112px); }
  .upcoming { margin-top: clamp(48px, 7vw, 80px); display: grid; gap: 24px; }
</style>
