---
import { projects } from "@/data";
import { LANGS, type Lang } from "@/i18n";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { copy } = LANGS[lang];
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="head" data-reveal>
      <div>
        <p class="eyebrow">{copy.work.eyebrow}</p>
        <h2 id="work-title" class="section-title">{copy.work.title}</h2>
      </div>
      <p class="count" aria-hidden="true">0{projects.length}</p>
    </div>
    <div class="grid">
      {projects.map((project, i) => <ProjectCard project={project} lang={lang} delay={i * 120} />)}
    </div>
  </div>
</section>

<style>
  .head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: clamp(36px, 5vw, 60px); }
  .count { font-family: var(--font-mono); font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1; color: var(--line-strong); letter-spacing: -0.04em; }
  .grid { display: grid; gap: clamp(20px, 3vw, 32px); }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
