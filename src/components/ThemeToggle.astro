---
import Icon from "./Icon.astro";

interface Props {
  labelToDark: string;
  labelToLight: string;
}
const { labelToDark, labelToLight } = Astro.props;
---

<button class="theme-toggle" type="button" aria-label={labelToDark} data-theme-toggle data-label-dark={labelToDark} data-label-light={labelToLight}>
  <span class="icons" aria-hidden="true">
    <Icon name="sun" class="sun" />
    <Icon name="moon" class="moon" />
  </span>
</button>

<script>
  import "@/scripts/theme";
</script>

<style>
  .theme-toggle {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; color: var(--muted); overflow: hidden;
    transition: color 200ms var(--ease), background-color 200ms var(--ease);
  }
  .theme-toggle:hover { color: var(--text); background: var(--surface-2); }
  .icons { position: relative; width: 19px; height: 19px; }
  .icons :global(svg) { position: absolute; inset: 0; width: 19px; height: 19px; transition: transform 500ms var(--ease), opacity 300ms var(--ease); }
  /* Shows the theme you would switch TO; the icons rotate through each other. */
  .icons :global(.sun) { opacity: 0; transform: rotate(-90deg) scale(0.5); }
  :global(:root[data-theme="dark"]) .icons :global(.sun) { opacity: 1; transform: none; }
  :global(:root[data-theme="dark"]) .icons :global(.moon) { opacity: 0; transform: rotate(90deg) scale(0.5); }
</style>
