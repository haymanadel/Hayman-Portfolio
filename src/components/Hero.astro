---
import { profile } from "@/data";
import { LANGS, type Lang } from "@/i18n";
import Icon from "./Icon.astro";
import PortraitCard from "./PortraitCard.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { copy } = LANGS[lang];
const words = profile.fullName.split(" ");
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="bg" aria-hidden="true"><div class="orb"></div></div>
  <div class="container layout">
    <div class="copy">
      <p class="status in" style="--d:0ms">
        <span class="live" aria-hidden="true"></span>{copy.hero.status}<span class="sep" aria-hidden="true">·</span><Icon name="pin" class="pin" />{copy.hero.location}
      </p>

      <h1 id="hero-name" class="name" lang="en" dir="ltr">
        {words.map((w, i) => <>{i > 0 && " "}<span class="mask"><span style={`--d:${80 + i * 90}ms`}>{w}</span></span></>)}
      </h1>

      <p class="roles">
        <span class="role in ar-flat" style="--d:260ms">{copy.hero.role}</span>
        <span class="title in" style="--d:330ms">{copy.hero.title}</span>
      </p>

      <p class="tagline in" style="--d:420ms">{copy.hero.tagline}</p>

      <div class="ctas in" style="--d:500ms">
        <a href="#work" class="btn btn-primary">{copy.hero.ctaWork} <Icon name="arrow-right" class="nudge" /></a>
        <a href="#contact" class="btn btn-ghost">{copy.hero.ctaContact}</a>
        {profile.cv && (
          <a href={profile.cv.href} download={profile.cv.fileName} class="btn btn-ghost"><Icon name="download" /> {copy.about.cv}</a>
        )}
      </div>
    </div>

    <div class="visual">
      <PortraitCard lang={lang} />
    </div>
  </div>

  <a href="#work" class="scroll in" style="--d:900ms" aria-hidden="true" tabindex="-1"><span class="line"></span>{copy.hero.scroll}</a>
</section>

<script>
  import "@/scripts/hero";
</script>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(28px, 6vw, 72px) clamp(72px, 10vw, 120px); }
  @media (min-width: 960px) { .hero { min-height: calc(100svh - var(--header-h)); display: grid; align-items: center; } }

  /* Background: engineering grid + one slow-drifting accent light. */
  .bg { position: absolute; inset: 0; z-index: -1; }
  .bg::before {
    content: ""; position: absolute; inset: 0;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 75% 65% at 50% 35%, #000 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 35%, #000 25%, transparent 75%);
  }
  .orb {
    position: absolute; width: min(70vmax, 900px); aspect-ratio: 1; inset-inline-end: -18%; top: -30%; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--accent) 26%, transparent), transparent 62%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .orb { animation: drift 26s ease-in-out infinite alternate; }
    @keyframes drift { to { transform: translate(-12%, 14%) scale(1.12); } }
  }

  .layout { display: grid; gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (min-width: 960px) { .layout { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); } }
  @media (max-width: 959px) { .visual { order: -1; } }

  .status { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.86rem; color: var(--muted); margin-bottom: clamp(18px, 3vw, 28px); }
  .live { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 35%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .live::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: var(--accent); animation: ping 2.4s var(--ease) infinite; }
    @keyframes ping { 0% { transform: scale(1); opacity: 0.7; } 70%, 100% { transform: scale(2.8); opacity: 0; } }
  }
  .sep { opacity: 0.5; }
  .status :global(.pin) { width: 14px; height: 14px; }

  .name { display: flex; flex-wrap: wrap; column-gap: 0.26em; font-size: var(--fs-display); font-weight: 750; letter-spacing: -0.045em; line-height: 0.92; }
  :global([dir="rtl"]) .name { justify-content: flex-end; }
  .mask { display: inline-block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .mask > span { display: inline-block; }

  .roles { display: grid; gap: 6px; margin-top: clamp(20px, 3vw, 30px); }
  .role {
    display: inline-flex; align-items: center; gap: 10px; width: fit-content;
    font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-text);
  }
  .role::before { content: ""; width: 18px; height: 1.5px; background: currentColor; }
  :global(:root[lang="ar"]) .role { font-family: var(--font-sans); font-size: 1rem; font-weight: 600; }
  .title { font-size: var(--fs-h3); font-weight: 650; letter-spacing: -0.025em; line-height: 1.15; }

  .tagline { margin-top: clamp(14px, 2vw, 18px); max-width: 30rem; font-size: var(--fs-lead); color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: clamp(26px, 3.5vw, 36px); }

  .visual { width: 100%; max-width: 440px; justify-self: center; }
  @media (min-width: 960px) { .visual { justify-self: end; } }

  .scroll {
    position: absolute; bottom: 28px; inset-inline-start: max(var(--gutter), calc((100vw - var(--maxw)) / 2));
    display: none; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
  }
  :global(:root[lang="ar"]) .scroll { font-family: var(--font-sans); font-size: 0.85rem; letter-spacing: 0; text-transform: none; }
  .line { position: relative; width: 40px; height: 1px; overflow: hidden; background: var(--line-strong); }
  @media (min-width: 960px) and (min-height: 760px) { .scroll { display: inline-flex; } }
  @media (prefers-reduced-motion: no-preference) {
    .line::after { content: ""; position: absolute; inset: 0; background: var(--text); animation: sweep 2.2s var(--ease-io) infinite; }
    @keyframes sweep { 0% { transform: translateX(-100%); } 60%, 100% { transform: translateX(100%); } }
  }

  /* Entrance: name rises out of a mask word by word; the rest follows. */
  @media (prefers-reduced-motion: no-preference) {
    .mask > span { animation: rise-mask 1000ms var(--ease) both; animation-delay: var(--d); }
    .in { animation: rise 900ms var(--ease) both; animation-delay: var(--d); }
    @keyframes rise-mask { from { transform: translateY(105%); } }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
  }
</style>
