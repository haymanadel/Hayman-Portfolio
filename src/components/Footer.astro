---
import { profile } from "@/data";
import { LANGS, type Lang } from "@/i18n";
import Wordmark from "./Wordmark.astro";

interface Props {
  lang: Lang;
}
const { copy, path } = LANGS[Astro.props.lang];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container row">
    <a href={`${path}#top`} class="brand" aria-label={`${profile.fullName} — ${copy.nav.home}`}><Wordmark /></a>
    <p class="copy">© {year} <span lang="en">{profile.fullName}</span></p>
    <a href="#top" class="top">{copy.footer.backToTop} <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer { padding-block: 36px 40px; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .brand, .top { display: inline-flex; align-items: center; min-height: 44px; }
  .copy { color: var(--muted); font-size: 0.9rem; }
  .top { gap: 8px; font-size: 0.9rem; color: var(--muted); transition: color 200ms var(--ease); }
  .top:hover { color: var(--text); }
  .top span { transition: transform 300ms var(--ease); }
  .top:hover span { transform: translateY(-3px); }
</style>
