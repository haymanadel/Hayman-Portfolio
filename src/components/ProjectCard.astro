---
import type { Project } from "@/data/types";
import Icon from "./Icon.astro";
import ProjectPreview from "./ProjectPreview.astro";

interface Props {
  project: Project;
  /** Mirror the layout on wide screens (alternating rows). */
  flip?: boolean;
  /** Short card for projects whose case study is still being written. */
  compact?: boolean;
}

const { project, flip = false, compact = false } = Astro.props;
const VISIBLE = 4;
const first = project.highlights.slice(0, VISIBLE);
const rest = project.highlights.slice(VISIBLE);
const titleId = `project-${project.slug}`;
---

<article class:list={["project", { flip, compact }]} aria-labelledby={titleId} data-reveal>
  <div class="visual"><ProjectPreview project={project} /></div>

  <div class="content">
    <p class="meta mono"><span>{project.category}</span><span aria-hidden="true">/</span><span>{project.year}</span></p>
    <h3 id={titleId}>{project.name}</h3>
    <p class="summary">{project.summary}</p>

    {project.note ? (
      <p class="note mono">{project.note}</p>
    ) : (
      <>
        <p class="role"><span class="mono">My role</span>{project.role}</p>

        {first.length > 0 && (
          <ul role="list" class="highlights">
            {first.map((h) => <li>{h}</li>)}
          </ul>
        )}
        {rest.length > 0 && (
          <details class="more">
            <summary>
              <span class="closed">+ {rest.length} more features</span><span class="opened">Show fewer</span>
            </summary>
            <ul role="list" class="highlights">
              {rest.map((h) => <li>{h}</li>)}
            </ul>
          </details>
        )}

        {project.technologies.length > 0 && (
          <ul role="list" class="tech" aria-label={`Technologies used in ${project.name}`}>
            {project.technologies.map((t) => <li class="chip">{t}</li>)}
          </ul>
        )}

        {project.links.length > 0 && (
          <div class="links">
            {project.links.map((l) => (
              <a class="btn btn-dark" href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} <Icon name="arrow-up-right" class="nudge" />
                <span class="visually-hidden">(opens {project.name} in a new tab)</span>
              </a>
            ))}
          </div>
        )}
      </>
    )}
  </div>
</article>

<style>
  .project { display: grid; gap: clamp(24px, 4vw, 40px); align-items: center; }
  @media (min-width: 960px) {
    .project { grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: clamp(40px, 5vw, 72px); }
    .project.flip .visual { order: 2; }
  }
  .project:hover :global(.frame) { transform: translateY(-4px); }

  .meta { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .meta span:first-child { color: var(--accent-text); }
  h3 { font-size: clamp(1.9rem, 4vw, 2.75rem); margin-top: 10px; }
  .summary { margin-top: 14px; color: var(--muted); font-size: 1.05rem; max-width: 36rem; }

  .role { display: grid; gap: 4px; margin-top: 20px; padding: 14px 16px; border-radius: var(--radius-sm); background: var(--surface-2); font-size: 0.95rem; }
  .role .mono { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

  .highlights { display: grid; margin-top: 18px; border-top: 1px solid var(--line); }
  .highlights li { position: relative; padding: 10px 0 10px 20px; border-bottom: 1px solid var(--line); font-size: 0.97rem; }
  .highlights li::before { content: ""; position: absolute; inset-inline-start: 2px; top: 1.2em; width: 7px; height: 7px; border-radius: 2px; background: var(--accent); }
  :global([dir="rtl"]) .highlights li { padding: 10px 20px 10px 0; }

  .more summary { display: inline-flex; align-items: center; min-height: 44px; margin-top: 6px; cursor: pointer; font-weight: 600; font-size: 0.92rem; list-style: none; border-bottom: 1px solid var(--line-strong); }
  .more summary::-webkit-details-marker { display: none; }
  .more .opened, .more[open] .closed { display: none; }
  .more[open] .opened { display: inline; }
  .more .highlights { margin-top: 10px; }

  .tech { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }

  /* Compact variant (case study in preparation) */
  .compact { padding: clamp(18px, 3vw, 24px); border: 1px dashed var(--line-strong); border-radius: var(--radius); }
  @media (min-width: 960px) { .compact { grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr); } }
  .compact h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .note { margin-top: 16px; font-size: 0.8rem; color: var(--accent-text); }
</style>
